// Nextflow AWS Batch Configuration
// Copy this to nextflow.config or use with: nextflow run main.nf -c aws.config

aws {
    // AWS Region
    region = 'us-east-1'
    
    // AWS Batch settings
    batch {
        cliPath = '/home/ec2-user/miniconda/bin/aws'
        jobRole = 'arn:aws:iam::YOUR_ACCOUNT:role/BatchJobRole'
        volumes = ['/tmp', '/var/tmp']
        maxTransferAttempts = 3
        delayBetweenAttempts = '10 sec'
    }
}

// AWS-specific process configuration
process {
    executor = 'awsbatch'
    queue = 'omicshub-queue'
    container = 'YOUR_ECR_REPO/omicshub-pipeline:latest'
    
    // Resource allocation for AWS
    withLabel: low_memory {
        memory = '2 GB'
        cpus = 1
        queue = 'omicshub-small'
    }
    
    withLabel: medium_memory {
        memory = '4 GB'
        cpus = 2
        queue = 'omicshub-medium'
    }
    
    withLabel: high_memory {
        memory = '8 GB'
        cpus = 4
        queue = 'omicshub-large'
    }
}

// S3 work directory
workDir = 's3://omicshub-work/scratch'

// Database connection (use AWS RDS)
params {
    db_host = 'omicshub-db.xxxxx.us-east-1.rds.amazonaws.com'
    db_port = 5432
    db_name = 'omicshub'
    db_user = 'postgres'
    db_password = 'YOUR_PASSWORD'  // Use AWS Secrets Manager in production
}

// AWS-specific parameters
params {
    outdir = 's3://omicshub-results/pipeline-output'
    publish_dir_mode = 'copy'
}

// Enable AWS CloudWatch logs
tower {
    enabled = true
    accessToken = 'YOUR_TOWER_TOKEN'
}

/*
To use this configuration:

1. Set up AWS Batch:
   - Create compute environments
   - Create job queues (small, medium, large)
   - Create job role with S3 and ECR permissions

2. Push Docker image to ECR:
   docker build -t omicshub-pipeline .
   docker tag omicshub-pipeline:latest YOUR_ECR_REPO/omicshub-pipeline:latest
   docker push YOUR_ECR_REPO/omicshub-pipeline:latest

3. Create S3 buckets:
   aws s3 mb s3://omicshub-work
   aws s3 mb s3://omicshub-results

4. Set up RDS PostgreSQL:
   - Create RDS instance
   - Configure security groups
   - Initialize database schema

5. Run pipeline:
   nextflow run main.nf -c aws.config
*/
