// Nextflow Configuration for OmicsHub Pipeline
// Author: OmicsHub Project
// Date: January 14, 2026

// Pipeline Metadata
manifest {
    name = 'OmicsHub Data Pipeline'
    author = 'OmicsHub Team'
    homePage = 'https://github.com/amuslu87/omicshub'
    description = 'Ontology-driven genomic data integration pipeline'
    mainScript = 'main.nf'
    version = '1.0.0'
    nextflowVersion = '>=23.04.0'
}

// Default Parameters
params {
    // Data source parameters
    email = 'amuslu@nmu.edu'  // For NCBI Entrez
    gene_list = 'BRCA1,BRCA2,TP53,PTEN,KRAS,EGFR,NRAS,BRAF,PIK3CA,MAPK1'
    max_genes = 10
    
    // Database parameters
    db_host = 'localhost'
    db_port = 5432
    db_name = 'omicshub'
    db_user = 'postgres'
    db_password = '7856'
    
    // Ontology parameters
    go_obo_url = 'http://purl.obolibrary.org/obo/go.obo'
    max_go_terms = 1000
    
    // Output directories
    outdir = 'results'
    publish_dir_mode = 'copy'
    
    // Resource limits
    max_memory = '8.GB'
    max_cpus = 4
    max_time = '2.h'
}

// Process Resource Profiles
profiles {
    // Local execution (default)
    standard {
        process.executor = 'local'
        process.container = 'python:3.12-slim'
        docker.enabled = false
    }
    
    // Docker execution
    docker {
        process.executor = 'local'
        docker.enabled = true
        docker.userEmulation = true
        process.container = 'omicshub-api:latest'
    }
    
    // High-performance computing
    hpc {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.clusterOptions = '--account=omics'
    }
    
    // AWS Batch
    aws {
        process.executor = 'awsbatch'
        process.queue = 'omicshub-queue'
        aws.region = 'us-east-1'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
    }
    
    // Testing profile (smaller datasets)
    test {
        params.max_genes = 3
        params.max_go_terms = 100
    }
}

// Process Configuration
process {
    // Error handling
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 2
    maxErrors = '-1'
    
    // Resource labels for different process types
    withLabel: low_memory {
        memory = { 2.GB * task.attempt }
        cpus = 1
        time = { 30.m * task.attempt }
    }
    
    withLabel: medium_memory {
        memory = { 4.GB * task.attempt }
        cpus = 2
        time = { 1.h * task.attempt }
    }
    
    withLabel: high_memory {
        memory = { 8.GB * task.attempt }
        cpus = 4
        time = { 2.h * task.attempt }
    }
}

// Execution Reports
timeline {
    enabled = true
    file = "${params.outdir}/execution_timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/execution_report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/execution_trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_dag.html"
}

// Cleanup
cleanup = false
