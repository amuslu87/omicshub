// Nextflow HPC (SLURM) Configuration
// Copy this to nextflow.config or use with: nextflow run main.nf -c hpc.config

// SLURM executor settings
process {
    executor = 'slurm'
    queue = 'normal'
    clusterOptions = '--account=omics_research --partition=standard'
    
    // Error handling for HPC
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries = 3
    
    // Resource allocation
    withLabel: low_memory {
        memory = { 2.GB * task.attempt }
        cpus = 1
        time = { 1.h * task.attempt }
        clusterOptions = '--account=omics_research --partition=standard --qos=normal'
    }
    
    withLabel: medium_memory {
        memory = { 4.GB * task.attempt }
        cpus = 2
        time = { 2.h * task.attempt }
        clusterOptions = '--account=omics_research --partition=standard --qos=normal'
    }
    
    withLabel: high_memory {
        memory = { 8.GB * task.attempt }
        cpus = 4
        time = { 4.h * task.attempt }
        clusterOptions = '--account=omics_research --partition=highmem --qos=priority'
    }
}

// Singularity container support (common on HPC)
singularity {
    enabled = true
    autoMounts = true
    runOptions = '--bind /scratch --bind /data'
    cacheDir = '/scratch/$USER/singularity-cache'
}

// Container settings
process.container = 'docker://python:3.12-slim'

// Work directory on HPC scratch space
workDir = "/scratch/$USER/omicshub-work"

// Database connection (HPC cluster database)
params {
    db_host = 'hpc-db.cluster.internal'
    db_port = 5432
    db_name = 'omicshub'
    db_user = System.getenv('USER')
    db_password = System.getenv('DB_PASSWORD')
}

// Output directory
params {
    outdir = "/data/$USER/omicshub-results"
    publish_dir_mode = 'copy'
}

// HPC-specific parameters
params {
    max_memory = 64.GB
    max_cpus = 32
    max_time = 48.h
}

// Enable detailed logging
trace {
    enabled = true
    file = "${params.outdir}/slurm_trace.txt"
    fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,rss,vmem,peak_rss,peak_vmem'
}

// Email notifications
notification {
    enabled = true
    to = System.getenv('USER') + '@university.edu'
}

/*
To use this configuration:

1. Load required modules:
   module load nextflow/23.04.0
   module load singularity/3.8.0
   module load python/3.12

2. Set environment variables:
   export DB_PASSWORD="your_password"

3. Prepare Singularity image:
   singularity pull docker://python:3.12-slim

4. Submit to SLURM:
   sbatch --wrap="nextflow run main.nf -c hpc.config"

   Or create a SLURM submission script:
   
   #!/bin/bash
   #SBATCH --job-name=omicshub-pipeline
   #SBATCH --account=omics_research
   #SBATCH --time=24:00:00
   #SBATCH --mem=8G
   #SBATCH --cpus-per-task=2
   #SBATCH --output=pipeline_%j.log
   
   module load nextflow/23.04.0
   module load singularity/3.8.0
   
   nextflow run main.nf -c hpc.config -resume

5. Monitor job:
   squeue -u $USER
   tail -f pipeline_*.log
*/
